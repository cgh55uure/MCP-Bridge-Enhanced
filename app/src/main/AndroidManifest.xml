<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- 悬浮窗权限 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 前台服务权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 省电与白名单 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 开机自启 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 锁屏显示 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SCREEN_DIM_WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- 前台服务类型 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- 精确 Alarm 权限 (Android 12+) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- 获取应用列表 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".MCPBridgeApp"
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MCPBridgeEnhanced"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <!-- 主 Activity（同时也是启动 Activity） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.MCPBridgeEnhanced">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 悬浮窗设置 Activity -->
        <activity
            android:name=".floatwindow.FloatWindowSettingActivity"
            android:exported="false"
            android:theme="@style/Theme.MCPBridgeEnhanced.Dialog" />

        <!-- Cloudflare 隧道设置 Activity -->
        <activity
            android:name=".tunnel.cloudflare.CloudflareTunnelActivity"
            android:exported="false"
            android:theme="@style/Theme.MCPBridgeEnhanced" />

        <!-- 隧道服务 -->
        <service
            android:name=".tunnel.TunnelService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Cloudflare 隧道服务 -->
        <service
            android:name=".tunnel.cloudflare.CloudflareTunnelService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 悬浮窗服务 -->
        <service
            android:name=".floatwindow.FloatWindowService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- 守护服务 - 前台保活 -->
        <service
            android:name=".keepalive.DaemonService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaPlayback" />

        <!-- JobScheduler 保活 -->
        <service
            android:name=".keepalive.JobSchedulerKeepAlive"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- 双进程守护 -->
        <service
            android:name=".keepalive.DoubleProcessKeepAlive"
            android:exported="false"
            android:process=":daemon"
            android:foregroundServiceType="dataSync|mediaPlayback" />

        <!-- 广播接收器 -->
        <receiver
            android:name=".keepalive.BroadcastKeepAlive"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <action android:name="android.intent.action.PACKAGE_RESTARTED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- 开机自启接收器 -->
        <receiver
            android:name=".keepalive.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- AlarmManager 保活检查接收器 -->
        <receiver
            android:name=".keepalive.ForegroundKeepAlive$KeepAliveReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.mcpbridge.enhanced.ACTION_KEEPALIVE_CHECK" />
            </intent-filter>
        </receiver>

    </application>

</manifest>